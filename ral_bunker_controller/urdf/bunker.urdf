<robot  name="bunker_gps" xmlns:xacro="http://www.ros.org/wiki/xacro">

   <link name="base_footprint">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.0001"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>

  <joint name="base_footprint_to_base_link" type="fixed">
    <origin xyz="0 0 0.35" rpy="0 0 0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>
 
  <link
    name="base_link">
     <inertial>
      <origin
        xyz="0.0212410555532523 0.00475458359568469 -0.127580557949736"
        rpy="0 0 0" />
      <mass
        value="0.0001" />
      <inertia
        ixx="0.607716166684979"
        ixy="1.92178193996147E-05"
        ixz="-0.036532069356182"
        iyy="1.70041426855404"
        iyz="2.16963122007266E-05"
        izz="1.84232351935185" />
    </inertial>
    <visual>
      <origin
        xyz="0.53 -0.392 -0.358"
        rpy="1.57 0 3.14" />
      <geometry>
        <mesh
          filename="package://ral_bunker_controller/meshes/BUNKER.STL" scale="0.001 0.001 0.001" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.5 0.5 0.5  1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0.53 -0.392 -0.358"
        rpy="1.57 0 3.14" />
      <geometry>
        <mesh
          filename="package://ral_bunker_controller/meshes/BUNKER.STL" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>

  <!-- GPS SETTINGS -->
  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="gps_link">
  </link>

  <gazebo reference="gps_link">
      <sensor name="gps_sensor" type="gps">
          <always_on>true</always_on>
          <update_rate>1.0</update_rate>
          
          <plugin name="gps_controller" filename="libgazebo_ros_gps_sensor.so">
              <ros>
                  <remapping>~/out:=/gps/fix</remapping>
              </ros>
              <frame_name>gps_link</frame_name>
          </plugin>
      </sensor>
      <material>Gazebo/Grey</material>
  </gazebo>

  <!-- IMU SETTINGS -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
  </link>

   <!-- LIDAR -->
  <link name="velodyne">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.0001"/>
      <inertia ixx="0.0001"  ixy="0"  ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0508" length="0.055"/>
      </geometry>
    </visual>
  </link>

  <joint name="velodyne_joint" type="fixed">
    <parent link="base_link"/>
    <child link="velodyne"/>
    <origin xyz="0 0 0.46" rpy="0 0 0"/>
  </joint>

</robot>